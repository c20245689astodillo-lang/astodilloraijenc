<section id="contact" data-scroll-reveal class="darkmode mt-6 scroll-mt-24">
  <div class="contact-layout">
    <div>
      <p data-reveal-item class="section-eyebrow">Get in touch</p>
      <h2 data-reveal-item class="section-title">Let's build together!</h2>
      <p data-reveal-item class="mt-4 max-w-prose leading-7">
        Have a question or project in mind? Send me a message below.
      </p>
    </div>

    <form
      id="contactForm"
      action="/api/contact"
      method="POST"
      class="contact-form-panel grid gap-x-5 gap-y-4 sm:grid-cols-2"
    >
      <div class="honeypot" aria-hidden="true">
        <label for="contact-check">Leave this field empty</label>
        <input
          id="contact-check"
          name="contact_check"
          type="text"
          tabindex="-1"
          autocomplete="off"
        />
      </div>

      <div data-reveal-item class="flex flex-col gap-2">
        <label for="name" class="font-semibold">Name</label>
        <input type="text" id="name" name="name" autocomplete="name" maxlength="100" required class="contact-input contact-text-input" />
      </div>

      <div data-reveal-item class="flex flex-col gap-2">
        <label for="email" class="font-semibold">Email</label>
        <input type="email" id="email" name="email" autocomplete="email" maxlength="254" required class="contact-input contact-text-input" />
      </div>

      <div data-reveal-item class="flex flex-col gap-2 sm:col-span-2">
        <label for="message" class="font-semibold">Message</label>
        <textarea name="message" id="message" rows="5" maxlength="2000" required class="contact-input contact-message-input"></textarea>
      </div>

      <div data-reveal-item class="mt-2 flex flex-wrap items-center gap-4 sm:col-span-2">
        <button type="submit" class="btn-secondary">Send Message</button>
      </div>
    </form>
  </div>
</section>
