---
import { Image } from "astro:assets";
import heroPortrait from "../../images/raijen-hero.jpg";
---

<section id="hero" class="hero-layout scroll-mt-24">
  <div class="hero-copy">
    <p data-intro-eyebrow class="hero-kicker">
      <span class="hero-kicker-dot" aria-hidden="true"></span>
      Creative visuals &amp; practical technology
    </p>
    <h1 data-intro-title class="hero-title">
      Creative ideas.<br />
      <span class="hero-title-accent">Built to work.</span>
    </h1>
    <p data-intro-copy class="hero-description">
      I turn ideas into polished visuals, responsive websites, and practical systems that make everyday work easier.
    </p>

    <div class="hero-actions">
      <a data-intro-action class="btn-secondary" href="#services">
        Explore services
        <span aria-hidden="true">&rarr;</span>
      </a>
      <a class="hero-secondary" href="#contact">Let's talk</a>
    </div>

  </div>

  <article class="hero-showcase" aria-label="Portfolio portrait">
    <figure class="hero-image-frame">
      <Image
        src={heroPortrait}
        alt="Portrait of a woman wearing sunglasses outdoors"
        class="hero-feature-image"
        loading="eager"
      />
      <span class="hero-image-label">Meet Raijen</span>
      <span class="hero-image-count">Portfolio</span>
    </figure>

    <div class="hero-showcase-footer">
      <div>
        <p class="hero-project-kicker">The person behind the work</p>
        <h2>Raijen C. Astodillo</h2>
        <p class="mt-1 text-sm text-purple-100">System analyst &amp; web developer</p>
      </div>
      <a href="#services" class="hero-showcase-link" aria-label="Explore all services">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
    </div>
  </article>
</section>
