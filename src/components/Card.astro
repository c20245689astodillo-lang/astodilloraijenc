---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  desc: string;
  image?: ImageMetadata | string;
  alt?: string;
  imageFit?: "cover" | "contain";
  class?: string;
  reveal?: boolean;
  index?: string;
}

const { title, desc, image, alt = title, imageFit = "cover", class: className = "", reveal = false, index } = Astro.props;
const fitClass = imageFit === "contain" ? "object-contain" : "object-cover";
---

<article data-reveal-item={reveal ? "" : undefined} class:list={["service-card", className]}>
  <figure class="service-art" aria-hidden={image ? undefined : "true"}>
    {index && <span class="service-index" aria-hidden="true">{index}</span>}
    {typeof image === "string" ? (
      <img src={image} alt={alt} class:list={["h-full w-full", fitClass]} loading="lazy" decoding="async" />
    ) : image ? (
      <Image src={image} alt={alt} class:list={["h-full w-full", fitClass]} loading="lazy" />
    ) : (
      <slot name="image" />
    )}
  </figure>
  <div class="flex flex-1 flex-col">
    <h3>{title}</h3>
    <p class="service-description">{desc}</p>
  </div>
</article>
