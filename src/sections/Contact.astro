  <section id="contact" class="darkmode scroll-mt-24">
                <h2 class="text-3xl font-extrabold mb-6">Let's build together!</h2>
                <form action="#" class="flex flex-col gap-2 max-w-xl">

                    <label for="name" class="font-semibold">Name</label>
                    <input type="text" id="name" name="name" required
                        class="mb-3 rounded-full bg-white text-purple-950 border border-purple-950 px-5 py-2 focus:outline-none focus:ring-2 focus:ring-purple-950">

                    <label for="email" class="font-semibold">Email</label>
                    <input type="email" name="email" id="email" required
                        class="mb-3 rounded-full bg-white text-purple-950 border border-purple-950 px-5 py-2 focus:outline-none focus:ring-2 focus:ring-purple-950">

                    <label for="message" class="font-semibold">Message</label>
                    <textarea name="message" id="message" rows="5" required
                        class="mb-3 rounded-2xl bg-white text-purple-950 border border-purple-950 px-5 py-3 focus:outline-none focus:ring-2 focus:ring-purple-950"></textarea>

                    <button type="submit" class="btn-secondary self-start">
                        Send Message
                    </button>
                </form>
            </section>