---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const name = "Raijen C Astodillo";
const position = "Web Developer";
const description = "Portfolio of Raijen C Astodillo, system analyst and web developer.";
---

<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{name} | {position}</title>
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem("portfolio-theme");
        document.documentElement.classList.toggle("dark", savedTheme ? savedTheme === "dark" : true);
      } catch {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div id="progressBar" aria-hidden="true" class="progress-bar"></div>

    <div class="site-shell">
      <Header />
      <main id="main-content">
        <slot />
      </main>
    </div>
    <Footer />

    <script>
      import "../scripts/animation.js";
    </script>
    <script>
      import { FallingLeaves } from "falling-leaves";

      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        new FallingLeaves({ shapes: ["maple", "oak", "ginkgo", "birch", "oval"] });
      }
    </script>
  </body>
</html>
